{
  "request": {
    "method": "POST",
    "url": "/api/partners/v1/coupons/status",
    "headers": {
      "x-api-key": {
        "equalTo": "valid-api-key"
      }
    },
    "bodyPatterns": [
      {
        "equalToJson": {
          "couponCode": "NOTFOUND"
        }
      }
    ]
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "errorCode": "COUPON_NOT_FOUND",
      "message": "Cupom nao encontrado no parceiro"
    }
  }
}